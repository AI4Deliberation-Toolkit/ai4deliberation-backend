# Bridge end-to-end test configuration.
# Copy to .env.bridge and fill in real values.

# Required
BRIDGE_HMAC_SECRET=<shared-secret-32-bytes-or-more>

# Note: project_id is supplied by the caller (e.g. Frankly) in each request —
# no server-side event→project mapping is needed for the active flow.
# See INTEGRATION.md for the request shape.

# Dormant — currently unused in the request path. Reserved for an optional
# future check where the bridge enforces a known event→project mapping.
# DEMBRANE_PROJECT_MAP='{"ev-test-001":"<real-dembrane-project-id>"}'

# Optional / parked
DEMBRANE_BASE_URL=https://api.dembrane.com
DEMBRANE_API_KEY=

# For the test script only
BRIDGE_URL=http://localhost:8100
